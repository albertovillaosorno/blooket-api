{
  "manifest_version": 3,
  "minimum_chrome_version": "110",
  "name": "Blooket API",
  "version": "26.4.0.0",
  "description": "Connect Blooket to your local teaching workspace.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": ["storage", "scripting"],
  "host_permissions": [
    "https://dashboard.blooket.com/*",
    "https://id.blooket.com/*",
    "http://127.0.0.1/*",
    "http://127.0.0.2/*"
  ],
  "background": {
    "service_worker": "src/service/browser-extension/adapter-inbound/worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/*", "http://127.0.0.2/*"],
      "js": ["src/ui/browser-extension/adapter-inbound/workspace.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    },
    "default_title": "Blooket API",
    "default_popup": "src/ui/browser-extension/adapter-inbound/popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "version_name": "26.4.0"
}
