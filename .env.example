# Development and test use only.
# Production credentials belong in the host secret store, not this file.
# Fill each value between the double quotes. Keep the quotes in place.
# Optional values may remain empty: "". Do not commit a populated .env.

# Blooket account
BLOOKET_EMAIL=""
BLOOKET_PASSWORD=""

# Local browser UI and HTTP API (loopback only)
LOCAL_HTTP_PORT="2607"

# Online MCP connection through the user-provisioned Cloudflare Tunnel
# Use the full public HTTPS URL ending in /mcp, not a bare hostname.
# Example: https://www.example.com/mcp
# Online access starts only when both the URL and tunnel token are set.
MCP_PUBLIC_URL=""
CLOUDFLARE_TUNNEL_TOKEN=""
# Tunnel origin: http://127.0.0.1:2608 when LOCAL_HTTP_PORT is 2607.
# Its port is LOCAL_HTTP_PORT + 1; leave the hostname Path filter empty.

# Required for online access: additional approval in the local UI.
# A salted verifier stays in memory in development; production uses Keychain.
MCP_OWNER_PASSWORD=""

# Optional display identity (reserved; currently configured manually in AI)
MCP_DISPLAY_NAME="Blooket"
MCP_DISPLAY_DESCRIPTION="Create, edit, and publish Blooket game sets"
# Local icon path only; setting it does not publish the image automatically.
MCP_ICON_PATH="assets/icon/Blooket.png"
