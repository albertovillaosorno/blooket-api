{
  "name": "@blooket-api/repository",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "check": ".dependencies/pnpm/node_modules/.bin/tsc -p tsconfig.json",
    "test": "node --test --test-concurrency=4 $(find tests -name '*_tests.ts')",
    "provider:drift:check":
      "npm run provider:drift:pages && npm run provider:drift:worker",
    "provider:drift:pages":
      "node --test tests/platforms/blooket-browser/adapter-outbound/*_tests.ts",
    "provider:drift:worker":
      "node --test tests/service/browser-extension/adapter-inbound/*_tests.ts",
    "validate":
      "npm run check && npm run roadmap:check && npm run validate:tests",
    "start": "node src/service/background-service/adapter-inbound/main.ts",
    "dev": "npm start -- --development",
    "validate:tests": "npm test && jig check --root . && jig validate --root .",
    "blooket": "node src/cli/executable/adapter-inbound/blooket.ts",
    "launch": "node src/service/desktop-launcher/adapter-inbound/launcher.ts",
    "package": "node src/platforms/distribution/adapter-inbound/package.ts",
    "package:verify": "npm run package -- --verify",
    "release:manifest":
      "node src/platforms/distribution/adapter-inbound/update-manifest.ts",
    "macos:safari-smoke":
      "node src/platforms/distribution/adapter-inbound/macos-safari-smoke.ts",
    "roadmap:check":
      "node src/platforms/roadmap-files/adapter-outbound/check.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/yauzl": "3.4.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "sharp": "0.35.5",
    "yaml": "2.9.1",
    "yauzl": "3.4.0"
  },
  "version": "26.4.0"
}
