{
  "name": "@blooket-api/repository",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "check": ".dependencies/pnpm/node_modules/.bin/tsc -p tsconfig.json",
    "test": "node --test $(find tests -type f -name '*_tests.ts' -print)",
    "validate":
      "npm run check && npm run roadmap:check && npm run validate:tests",
    "start": "node src/service/background-service/adapter-inbound/main.ts",
    "dev": "npm start -- --development",
    "validate:tests": "npm test && jig check --root .",
    "blooket": "node src/cli/executable/adapter-inbound/blooket.ts",
    "launch": "node src/service/desktop-launcher/adapter-inbound/launcher.ts",
    "package": "node src/platforms/distribution/adapter-inbound/package.ts",
    "package:verify": "npm run package -- --verify",
    "roadmap:check":
      "node src/platforms/roadmap-files/adapter-outbound/check.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "sharp": "0.35.5",
    "yaml": "2.9.1"
  },
  "version": "26.4.0"
}
